<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sebastian.applespotifysync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>REPLACE_WITH_ABSOLUTE_PATH/run.sh</string>
    </array>

    <!-- Runs every 30 minutes while the Mac is awake -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>StandardOutPath</key>
    <string>REPLACE_WITH_ABSOLUTE_PATH/sync.log</string>
    <key>StandardErrorPath</key>
    <string>REPLACE_WITH_ABSOLUTE_PATH/sync.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
